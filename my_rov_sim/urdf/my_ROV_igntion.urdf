  <gazebo reference="camra_up_Link">
        <sensor name="camera_up" type="camera">
            <pose>0 0 0 0 1.57 0</pose>
            <visualize>true</visualize>
            <update_rate>10.0</update_rate>
            <alwaysOn>true</alwaysOn>
            <topic>camera_up/image_raw</topic>
            <gz_frame_id>camra_up_Link</gz_frame_id>
            <camera name="intel_realsense_r200">
                <camera_info_topic>camera_up/camera_info</camera_info_topic>
                <horizontal_fov>1.0</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>320</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
        </sensor>
  </gazebo>

  <gazebo reference="camera_down_Link">
        <sensor name="camera_dwon" type="camera">
            <pose>0 0 0 0 1.57 0</pose>
            <visualize>true</visualize>
            <update_rate>10.0</update_rate>
            <alwaysOn>true</alwaysOn>
            <topic>camera_down/image_raw</topic>
            <gz_frame_id>camera_down_Link</gz_frame_id>
            <camera name="intel_realsense_r200">
                <camera_info_topic>camera_down/camera_info</camera_info_topic>
                <horizontal_fov>1.0</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>320</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
        </sensor>
  </gazebo>


  <gazebo reference="base_link">
    <material>Gazebo/Red</material>
    <static>0</static>
    <self_collide>0</self_collide>
    <allow_auto_disable>1</allow_auto_disable>
  </gazebo>
  <gazebo reference="camera_down_Link">
    <material>Gazebo/Black</material>
    <static>0</static>
    <self_collide>0</self_collide>
    <allow_auto_disable>1</allow_auto_disable>
  </gazebo>
  <gazebo reference="camra_up_Link">
    <material>Gazebo/Black</material>
    <static>0</static>
    <self_collide>0</self_collide>
    <allow_auto_disable>1</allow_auto_disable>
  </gazebo>
  
<!-- Joint controllers -->
  <!--6 motor-->
    <gazebo>
      <plugin
        filename="ignition-gazebo-joint-position-controller-system"
        name="ignition::gazebo::systems::JointPositionController">
        <joint_name>BR</joint_name>
        <p_gain>0.1</p_gain>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin
        filename="ignition-gazebo-joint-position-controller-system"
        name="ignition::gazebo::systems::JointPositionController">
        <joint_name>BL</joint_name>
        <p_gain>0.1</p_gain>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin
        filename="ignition-gazebo-joint-position-controller-system"
        name="ignition::gazebo::systems::JointPositionController">
        <joint_name>MR</joint_name>
        <p_gain>0.1</p_gain>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin
        filename="ignition-gazebo-joint-position-controller-system"
        name="ignition::gazebo::systems::JointPositionController">
        <joint_name>ML</joint_name>
        <p_gain>0.1</p_gain>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin
        filename="ignition-gazebo-joint-position-controller-system"
        name="ignition::gazebo::systems::JointPositionController">
        <joint_name>UR</joint_name>
        <p_gain>0.1</p_gain>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin
        filename="ignition-gazebo-joint-position-controller-system"
        name="ignition::gazebo::systems::JointPositionController">
        <joint_name>UL</joint_name>
        <p_gain>0.1</p_gain>
      </plugin>
    </gazebo>
    <!--  6- thruster  -->

    <gazebo>
      <plugin
        filename="ignition-gazebo-thruster-system"
        name="ignition::gazebo::systems::Thruster">
        <namespace>rov</namespace>
        <joint_name>BR</joint_name>
        <thrust_coefficient>0.004422</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.2</propeller_diameter>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin
        filename="ignition-gazebo-thruster-system"
        name="ignition::gazebo::systems::Thruster">
        <namespace>rov</namespace>
        <joint_name>BL</joint_name>
        <thrust_coefficient>0.004422</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.2</propeller_diameter>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin
        filename="ignition-gazebo-thruster-system"
        name="ignition::gazebo::systems::Thruster">
        <namespace>rov</namespace>
        <joint_name>MR</joint_name>
        <thrust_coefficient>0.004422</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.2</propeller_diameter>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin
        filename="ignition-gazebo-thruster-system"
        name="ignition::gazebo::systems::Thruster">
        <namespace>rov</namespace>
        <joint_name>ML</joint_name>
        <thrust_coefficient>0.004422</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.2</propeller_diameter>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin
        filename="ignition-gazebo-thruster-system"
        name="ignition::gazebo::systems::Thruster">
        <namespace>rov</namespace>
        <joint_name>UR</joint_name>
        <thrust_coefficient>0.004422</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.2</propeller_diameter>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin
        filename="ignition-gazebo-thruster-system"
        name="ignition::gazebo::systems::Thruster">
        <namespace>rov</namespace>
        <joint_name>UL</joint_name>
        <thrust_coefficient>0.004422</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.2</propeller_diameter>
      </plugin>
    </gazebo>

      <!-- Lift and drag -->

      <!-- Vertical fin -->
    <gazebo>
      <plugin
        filename="ignition-gazebo-lift-drag-system"
        name="ignition::gazebo::systems::LiftDrag">
        <air_density>1000</air_density>
        <cla>4.13</cla>
        <cla_stall>-1.1</cla_stall>
        <cda>0.2</cda>
        <cda_stall>0.03</cda_stall>
        <alpha_stall>0.17</alpha_stall>
        <a0>0</a0>
        <area>0.0244</area>
        <upward>0 1 0</upward>
        <forward>1 0 0</forward>
        <link_name>lift_up</link_name>
        <cp>0 0 0</cp>
      </plugin>
    </gazebo>

      <!-- Horizontal fin -->
    <gazebo>
      <plugin
        filename="ignition-gazebo-lift-drag-system"
        name="ignition::gazebo::systems::LiftDrag">
        <air_density>1000</air_density>
        <cla>4.13</cla>
        <cla_stall>-1.1</cla_stall>
        <cda>0.2</cda>
        <cda_stall>0.03</cda_stall>
        <alpha_stall>0.17</alpha_stall>
        <a0>0</a0>
        <area>0.0244</area>
        <upward>0 0 1</upward>
        <forward>1 0 0</forward>
        <link_name>lift_up</link_name>
        <cp>0 0 0</cp>
      </plugin>
    </gazebo>
    <gazebo reference="base_link">
      <!-- hydrodynamics plugin-->
      <plugin
        filename="ignition-gazebo-hydrodynamics-system"
        name="ignition::gazebo::systems::Hydrodynamics">

        <xDotU>-4.876161</xDotU>
        <yDotV>-126.324739</yDotV>
        <zDotW>-126.324739</zDotW>
        <kDotP>0</kDotP>
        <mDotQ>-33.46</mDotQ>
        <nDotR>-33.46</nDotR>
        <xUabsU>-6.2282</xUabsU>
        <xU>0</xU>
        <yVabsV>-601.27</yVabsV>
        <yV>0</yV>
        <zWabsW>-601.27</zWabsW>
        <zW>0</zW>
        <kPabsP>-0.1916</kPabsP>
        <kP>0</kP>
        <mQabsQ>-632.698957</mQabsQ>
        <mQ>0</mQ>
        <nRabsR>-632.698957</nRabsR>
        <nR>0</nR>
        
      </plugin>
    </gazebo>

</robot>