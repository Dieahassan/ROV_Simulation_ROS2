<?xml version="1.0"?>
<scenario>
    <!-- ============================================================
         ENVIRONMENT
         ============================================================ -->
    <environment>
        <ned latitude="41.7777" longitude="3.0333"/>

        <ocean>
            <water density="1031.0" jerlov="0.15"/>
            <waves height="0.0"/>
            <particles enabled="true"/>
        </ocean>

        <atmosphere>
            <sun azimuth="20.0" elevation="50.0"/>
        </atmosphere>
    </environment>

    <!-- ============================================================
         MATERIALS
         Self-contained so this file does not depend on an external
         materials_looks.scn. Merge with your own material set if you
         already include one elsewhere.
         ============================================================ -->
    <materials>
        <material name="Concrete" density="2400.0" restitution="0.2"/>
        <material name="Steel" density="7800.0" restitution="0.3"/>
        <material name="Glass" density="2500.0" restitution="0.1"/>
        <material name="Plastic" density="1200.0" restitution="0.4"/>
        <material name="Rock" density="2600.0" restitution="0.1"/>
        <material name="Acrylic" density="300.0" restitution="0.9"/>
		<material name="Foam" density="30.0" restitution="0.3"/>
		<material name="Polyethylene" density="400.0" restitution="0.75"/>
		<material name="Ballast" density="408.0" restitution="0.75"/>


        <friction_table>
            <friction material1="Concrete" material2="Concrete" static="0.5" dynamic="0.4"/>
            <friction material1="Concrete" material2="Steel" static="0.4" dynamic="0.3"/>
            <friction material1="Concrete" material2="Glass" static="0.3" dynamic="0.2"/>
            <friction material1="Concrete" material2="Plastic" static="0.4" dynamic="0.3"/>
            <friction material1="Concrete" material2="Rock" static="0.5" dynamic="0.4"/>
            <friction material1="Steel" material2="Steel" static="0.3" dynamic="0.2"/>
            <friction material1="Steel" material2="Glass" static="0.2" dynamic="0.15"/>
            <friction material1="Steel" material2="Plastic" static="0.3" dynamic="0.2"/>
            <friction material1="Steel" material2="Rock" static="0.4" dynamic="0.3"/>
            <friction material1="Glass" material2="Glass" static="0.1" dynamic="0.1"/>
            <friction material1="Glass" material2="Plastic" static="0.2" dynamic="0.15"/>
            <friction material1="Glass" material2="Rock" static="0.2" dynamic="0.15"/>
            <friction material1="Plastic" material2="Plastic" static="0.3" dynamic="0.2"/>
            <friction material1="Plastic" material2="Rock" static="0.3" dynamic="0.2"/>
            <friction material1="Rock" material2="Rock" static="0.6" dynamic="0.5"/>
        </friction_table>
    </materials>

    <!-- ============================================================
         LOOKS
         High visual-contrast set: flat wall tone + saturated,
         checker-like obstacle colors so ORB-SLAM has plenty of
         well-separated corner/edge features to track.
         ============================================================ -->
    <looks>
        <look name="wall_concrete" gray="0.55" roughness="0.9"/>
        <look name="wall_concrete_dark" gray="0.35" roughness="0.9"/>
        <look name="floor_concrete" gray="0.45" roughness="0.95"/>
        <look name="window_frame" rgb="0.15 0.15 0.15" roughness="0.6" metalness="0.7"/>
        <look name="window_glass" rgb="0.55 0.75 0.85" roughness="0.05" metalness="0.1"/>
        <look name="pipe_rust" rgb="0.55 0.25 0.1" roughness="0.7" metalness="0.4"/>
        <look name="vent_steel" rgb="0.6 0.6 0.65" roughness="0.4" metalness="0.8"/>
        <look name="obstacle_red" rgb="0.75 0.1 0.1" roughness="0.5"/>
        <look name="obstacle_yellow" rgb="0.85 0.75 0.05" roughness="0.5"/>
        <look name="obstacle_blue" rgb="0.1 0.25 0.75" roughness="0.5"/>
        <look name="obstacle_green" rgb="0.15 0.6 0.2" roughness="0.5"/>
        <look name="obstacle_orange" rgb="0.85 0.45 0.05" roughness="0.5"/>
        <look name="obstacle_white" rgb="0.85 0.85 0.85" roughness="0.4"/>
        <look name="obstacle_black" rgb="0.08 0.08 0.08" roughness="0.4"/>
        <look name="dock_steel" rgb="0.5 0.5 0.55" roughness="0.3" metalness="0.9"/>
        <look name="Red" rgb="1.0 0.0 0.0" roughness="1" metalness="0.0"/>
        <look name="blue" rgb="0.0 0.0 1.0" roughness="0.8" metalness="0.0"/>
		<look name="cyan" rgb="0.0 1.0 1.0" roughness="0.8" metalness="0.0"/>
        <look name="White" rgb="1.0 1.0 1.0" roughness="0.8" metalness="0.0"/>
        <look name="black" gray="0.01" roughness="0.2" metalness="0.0"/>
        <look name="transparent" gray="1.0" roughness="0.0" metalness="0.0"/>
    </looks>

    <!-- ============================================================
         FLOOR
         ============================================================ -->
    <static name="TankFloor" type="cylinder">
        <dimensions radius="10.00" height="0.20"/>
        <world_transform xyz="0.0 0.0 -0.10" rpy="0.0 0.0 0.0"/>
        <material name="Concrete"/>
        <look name="floor_concrete"/>
    </static>

