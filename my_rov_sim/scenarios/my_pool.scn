<?xml version="1.0"?>
<scenario>	    
    <!--   Define environment state (water type, currents, atmosphere, ...)   -->
	<environment>
		<ned latitude="41.7777" longitude="3.0333"/>

		<ocean>
			<water density="1031.0" jerlov="0.15"/>

			<waves height="0.0"/>

			<particles enabled="true"/>

            <current type="uniform">
                <velocity xyz="10.0 10.0 0.0"/>
            </current>
            <current type="jet">
                <center xyz="0.0 0.0 3.0"/>
                <outlet radius="100.0"/>
                <velocity xyz="0.0 2.0 0.0"/>
            </current>
            
		</ocean>

		<atmosphere>
			<sun azimuth="20.0" elevation="50.0"/>
		</atmosphere>

	</environment>

    <!--   Inlcude utils (materials and looks)  -->
    <include file="$(find my_rov_sim)/scenarios/materials_looks.scn"/>


    <!--   Inlcude objects (obstacles, map features, dynamic objects, creatures)  -->
       
    <!-- <include file="$(find my_rov_sim)/scenarios/.scn"/> -->

    <static name="pool" type="model">
        <physical>
            <mesh filename="my_pool/mesh/pool.obj" scale="0.0001" convex="false"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <material name="Neutral"/>
        <look name="Red"/>
        <!--<world_transform xyz="-10 -20 10.5" rpy="${-pi/2} 0.0 0.0"/>-->
        <world_transform xyz="1.0 1.0 1.0" rpy="${-pi/2} 0.0 0.0"/>
    </static>     
  

    <!--   Inlcude Addiitonal world actuators/sensors (lights, cameras, etc) not attached to Robots  -->

    <!--   Inlcude Robots  -->
    <include file="$(find my_rov_sim)/scenarios/rov_3.scn"/>
    <!-- <include file="$(find bluerov2_sim)/scenarios/bluerov2.scn"/> -->



</scenario>