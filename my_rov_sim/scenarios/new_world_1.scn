    <!-- ============================================================
         FLOOR
         ============================================================ -->
    <static name="TankFloor" type="cylinder">
        <dimensions radius="10.00" height="0.20"/>
        <world_transform xyz="0.0 0.0 -0.10" rpy="0.0 0.0 0.0"/>
        <material name="Concrete"/>
        <look name="floor_concrete"/>
    </static>

